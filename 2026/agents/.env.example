# Copy to .env and fill in. .env is gitignored — never commit a key.
#
#   cp .env.example .env
#   uv run python llm.py check

# mock | vllm | nvidia
ARMLLM_PROFILE=mock

# --- nvidia profile -------------------------------------------------------
# Internal NVIDIA inference gateway. For building and rehearsing only —
# do NOT distribute this key or endpoint to the room.
# ARMLLM_PROFILE=nvidia
# ARMLLM_API_KEY=nv-...
# ARMLLM_MODEL=azure/openai/gpt-5.5

# --- vllm profile ---------------------------------------------------------
# What the class uses: an OpenAI-compatible server on the shared GPU box.
# ARMLLM_PROFILE=vllm
# ARMLLM_BASE_URL=http://localhost:8000/v1
# ARMLLM_MODEL=Qwen/Qwen3-8B
# ARMLLM_API_KEY=EMPTY
